{
  "name": "citesync",
  "version": "0.1.0",
  "private": true,
  "description": "CiteSync — deterministic DOCX citation analysis pipeline (reader, source map, AcademicDocument model)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "benchmark:perf": "tsx benchmarks/perf.ts",
    "benchmark:quality": "tsx benchmarks/quality.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
